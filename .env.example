# Whatsapp bot
TARGET_GROUP_ID=120363402800142448@g.us

# Target newspapers configuration (comma-separated search:name pairs, or JSON array)
TARGET_NEWSPAPERS=La Provincia Las Palmas:La Provincia, Canarias7:Canarias7, El Pais:El País

# Telegram Worker Account (Secondary number running the bot to upload files)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE_NUMBER=+34600000000
TELEGRAM_SESSION_PATH=telegram_session

# Optional Telegram Bot Token (from @BotFather for instant interactive commands: /status, /retry, /help)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Admin Account (Your main personal phone number, user ID, or @username for QR login, error alerts)
TELEGRAM_ADMIN_CHAT=+34600000001

# Newspapers Group/Channel (Where daily newspaper PDFs are delivered)
TELEGRAM_NEWSPAPERS_CHAT_NAME=Your Newspapers Channel Name
TELEGRAM_NEWSPAPERS_CHAT_ID=1234567890

# Dev flag: set to true to bypass once-a-day restriction
SKIP_DATE_CHECK=false

# Optional: Delay (in seconds) before sending Telegram alert on WhatsApp disconnect (default: 300 = 5 minutes)
DISCONNECT_ALERT_DELAY_SECONDS=300